{
  "name": "@anemo/server",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/main.ts",
    "start": "node src/main.ts",
    "migrate": "node src/platform/migrate-cli.ts",
    "migration": "node --env-file-if-exists=../.env src/modules/migration/cli.ts",
    "test": "node --test --test-concurrency=4 'test/**/*.test.ts'",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "hono": "4.13.13",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
