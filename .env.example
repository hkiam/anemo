# Anemo – Beispielkonfiguration. Kopieren nach .env und anpassen. Vollständige Referenz: docs/handbuch/20-betrieb.md
# Leere/auskommentierte Werte = Funktion aus.

# --- Grundbetrieb ---
ANEMO_PUBLIC_URL=https://anemo.firma.de
# ANEMO_ADMIN_PASSWORD=                 # sonst Zufallspasswort in /data/initial-admin-password.txt
# ANEMO_SIGNING_KEY_FILE=/data/signatur.pem   # openssl genpkey -algorithm ed25519 -out signatur.pem
# ANEMO_ACCESS_LOG_DAYS=730

# --- Anmeldung: OIDC (Keycloak / Entra ID) ---
# OIDC_ISSUER=https://keycloak.firma.de/realms/firma
# OIDC_CLIENT_ID=anemo
# OIDC_CLIENT_SECRET=
# OIDC_GROUPS_CLAIM=groups
# OIDC_ADMIN_GROUP=anemo-admins
# OIDC_TOKEN_AUTH=basic                 # Entra: post
# OIDC_LABEL=Mit Firmenkonto anmelden

# --- Anmeldung: LDAP / Active Directory ---
# LDAP_URL=ldaps://dc1.firma.local:636
# LDAP_BASE_DN=DC=firma,DC=local
# LDAP_BIND_DN=CN=svc-anemo,OU=Dienste,DC=firma,DC=local
# LDAP_BIND_PASSWORD=
# LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={username}))
# LDAP_GROUP_PATTERN=^(QA|Anemo)-
# LDAP_ADMIN_GROUP=Anemo-Admins

# --- OpenProject ---
# OPENPROJECT_URL=https://openproject.firma.de
# OPENPROJECT_API_KEY=
# ANEMO_OPENPROJECT_REFRESH_MINUTES=15

# --- GitLab ---
# GITLAB_URL=https://gitlab.firma.de
# GITLAB_TOKEN=

# --- Jira (Parallelbetrieb, nur lesend) ---
# JIRA_HOST=jira.firma.lan:8080
# JIRA_BASIC_AUTH=benutzer:passwort
# ANEMO_JIRA_REFRESH_HOURS=6

# --- E-Mail ---
# SMTP_HOST=mail.firma.de
# SMTP_PORT=587
# SMTP_SECURE=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Anemo <anemo@firma.de>

# --- KI-Modell (optional) ---
# AI_BASE_URL=http://ki-server.firma.local:11434/v1
# AI_MODEL=qwen2.5:14b
# AI_ON_PREM=true
